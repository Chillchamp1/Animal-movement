# Source data is not kept in the repository. Fetch it, then rebuild:
#   python3 scripts/fetch_dryad.py
#   unzip -o 'data/raw/*.zip' -d data/raw/
#   python3 scripts/build_tracks.py && python3 scripts/build_risk.py
#   python3 scripts/build_seasonal.py && python3 scripts/build_standalone.py
data/raw/
data/processed/
dist/
*.zip
__pycache__/

# Raw deposit downloads, wherever they land. 18.6 MB of these were committed
# early on -- cougar and wolf RData, the Utah covariates and grid masks, a
# spreadsheet -- and read by nothing here. The DOIs in docs/dataset-audit.md
# are how to fetch them again.
*.RData
*.tif
*.xlsx

# route_eels.py caches elevation tiles here; they are refetchable.
.tilecache/
